{
  "name": "sohrani-moyu-rech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Цифровая версия настольной игры «Сохрани мою речь: книжное подполье СССР»",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx tools/simulate.ts",
    "data": "python3 -I tools/build_cards.py",
    "addresses": "tsx tools/addresses.ts",
    "talons": "tsx tools/talons.ts",
    "club": "tsx tools/club.ts",
    "patrons": "tsx tools/patrons.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
